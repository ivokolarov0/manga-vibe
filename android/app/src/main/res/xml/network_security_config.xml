<?xml version="1.0" encoding="utf-8"?>
<!-- The server is on the user's own network at an address only they know (192.168.x.x, a NAS name,
     a Tailscale name), usually without HTTPS. So plain HTTP is allowed everywhere. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
