<?xml version="1.0" encoding="utf-8"?>
<!-- The server is on the user's own network at an address only they know (192.168.x.x, a NAS name,
     a Tailscale name), usually without HTTPS. So plain HTTP is allowed everywhere.
     When it does use HTTPS, the certificate often comes from the user's own CA (mkcert, Caddy's
     local CA, a NAS's CA), which they installed on the phone. Android ignores such CAs in apps
     unless the config names them, so "user" CAs are trusted too. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration,AcceptsUserCertificates">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
